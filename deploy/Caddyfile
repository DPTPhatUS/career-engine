{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Keep the /api prefix: FastAPI routes already include /api/v1.
	@backend path /api/* /healthz
	handle @backend {
		reverse_proxy api:8000
	}

	# Vite assets are fingerprinted. Missing assets should return 404.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Direct visits to /u/<slug> and other React routes need index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
