# Copy to .env in the repository root, then fill in the blank values.
# Use only a hostname here, without https:// or a trailing slash.
APP_DOMAIN=career-engine.com
ACME_EMAIL=

# Generate a hexadecimal password with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Hexadecimal avoids special characters in the generated database URL.
POSTGRES_PASSWORD=

# Generate with: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# Keep this key across deployments; it decrypts saved Google credentials.
ENCRYPTION_KEY=

# Google OAuth client of type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional for the initial sign-in/profile smoke test.
# Autofill and tailoring need a key for the selected provider.
PROJECT_AUTOFILL_LLM_PROVIDER=mistral
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional GitHub metadata API token. Repository cloning still needs its own access.
GITHUB_TOKEN=
